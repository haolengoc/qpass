# PostgreSQL runtime/pooler URL and direct migration URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Optional isolated database for integration tests. Its database name must
# contain "dev" or "test" because the suite truncates test fixtures.
TEST_DATABASE_URL=

# Generate a unique value with: openssl rand -base64 32
AUTH_SECRET=
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Leave both empty in local development to skip confirmation email delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Both values are required in production. Local development uses memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Development seed credentials. Never use these values in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ORGANIZER_EMAIL=
SEED_ORGANIZER_PASSWORD=

# Keep false. An intentional production seed additionally requires this flag
# and all four non-demo SEED_* credentials.
ALLOW_PRODUCTION_SEED=false

# One-time production admin bootstrap. Remove these values immediately after use.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
